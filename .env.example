# Copy to .env and fill in. Never commit a real .env.

# --- LLM ---
# Provider: "anthropic" or "openai"
LLM_PROVIDER=anthropic
# Model override (defaults: claude-haiku-4-5 / gpt-4o-mini)
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000

# --- Storage ---
DB_PATH=pm_roadmap_agent.db
BRIEFS_DIR=briefs

# --- Pipeline tuning ---
CLUSTER_BATCH_SIZE=40
MAX_FEEDBACK_PER_RUN=500
TREND_MIN_COUNT=3
TREND_GROWTH_FACTOR=2.0

# --- App Store ingestion ---
APPSTORE_COUNTRY=us
APPSTORE_MAX_PAGES=5

# --- Weekly digest email (optional; printing is the default) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_FROM=
DIGEST_TO=
